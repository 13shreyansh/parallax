  "sentences": [
   {
    "text": "According to Swedish Wikipedia and Finnish Wikipedia, Finland was not allied with Germany de jure because no formal alliance treaty was concluded between them.",
    "cites": [
     5,
     7
    ]
   },
   {
    "text": "However, both sources state that Finland was allied with Germany de facto, as it fought using German resources and weapons, provided its territory for German use, and placed troops under German command.",
    "cites": [
     4,
     5,
     7
    ]
   }
